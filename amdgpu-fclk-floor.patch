+static int smu_v13_0_4_set_default_dpm_tables(struct smu_context *smu)
+{
+	struct smu_table_context *smu_table = &smu->smu_table;
+	int ret;
+
+	ret = smu_cmn_update_table(smu, SMU_TABLE_DPMCLOCKS, 0,
+				    smu_table->clocks_table, false);
+	if (ret)
+		return ret;
+
+	if (smu_table->clocks_table) {
+		DpmClocks_t *clk_table = smu_table->clocks_table;
+		int i;
+		for (i = 0; i < clk_table->NumDfPstatesEnabled; i++) {
+			if (clk_table->DfPstateTable[i].FClk < 800) {
+				dev_info(smu->adev->dev, "[amdgpu_fclk_fix] Clamping DfPstate %d FClk from %u to 800 MHz\n",
+					 i, clk_table->DfPstateTable[i].FClk);
+				clk_table->DfPstateTable[i].FClk = 800;
+			}
+		}
+	}
+
+	ret = smu_v13_0_4_set_soft_freq_limited_range(smu, SMU_FCLK, 800, 1600);
+	if (ret)
+		dev_warn(smu->adev->dev, "[amdgpu_fclk_fix] Failed to set initial FCLK range: %d\n", ret);
+	else
+		dev_info(smu->adev->dev, "[amdgpu_fclk_fix] Set initial FCLK range 800-1600 MHz\n");
+
+	return 0;
+}
